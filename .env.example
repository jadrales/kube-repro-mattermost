# ─── Minikube ────────────────────────────────────────────────────────────────
# Named profile keeps this cluster isolated from any default minikube cluster
PROFILE=mm-repro
MINIKUBE_CPUS=4
MINIKUBE_MEMORY=8192
MINIKUBE_DISK=40g
# Driver: docker (recommended on Windows/Mac), virtualbox, hyperv
MINIKUBE_DRIVER=docker

# ─── Kubernetes ──────────────────────────────────────────────────────────────
NAMESPACE=mattermost

# ─── Mattermost ──────────────────────────────────────────────────────────────
MM_VERSION=10.5.0
# Local domain used for ingress (add to /etc/hosts via `make hosts`)
MM_DOMAIN=mattermost.local
# Replica count for standard deployment (use make run-ha for HA)
MM_REPLICAS=1

# ─── Database ────────────────────────────────────────────────────────────────
DB_USER=mmuser
DB_PASSWORD=mmuser_password
DB_NAME=mattermost

# ─── MinIO (local S3-compatible filestore) ───────────────────────────────────
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=mattermost

# ─── License ─────────────────────────────────────────────────────────────────
# Place your Enterprise license at the path below (optional — runs Team Edition without it)
LICENSE_PATH=license.mattermost
